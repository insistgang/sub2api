# Package a locally cross-compiled fork binary without compiling on a small host.
# RUNTIME_IMAGE must be the verified matching upstream runtime, pinned by digest.
ARG RUNTIME_IMAGE
FROM ${RUNTIME_IMAGE}

ARG VERSION
ARG COMMIT
ARG BUILD_DATE
ARG BINARY_SHA256

LABEL org.opencontainers.image.source="https://github.com/insistgang/sub2api" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}"

COPY --chown=1000:1000 sub2api-linux-amd64 /app/sub2api
RUN test -n "${VERSION}" && test -n "${COMMIT}" && test -n "${BUILD_DATE}" && \
    test -n "${BINARY_SHA256}" && \
    printf '%s  /app/sub2api\n' "${BINARY_SHA256}" | sha256sum -c - && \
    chmod 0755 /app/sub2api && \
    /app/sub2api --version > /tmp/sub2api-version 2>&1 && \
    grep -F "Sub2API ${VERSION} (commit: ${COMMIT}, built: ${BUILD_DATE})" /tmp/sub2api-version && \
    rm /tmp/sub2api-version

# Keep the upstream entrypoint, runtime dependencies, health check and resources.
